# Supabase Project Settings > API から取得してコピーし、.env.local として保存する
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxx

# サーバー専用（絶対にブラウザ・git に出さない）
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# 社員コードをSupabase Authのメール形式に変換する際のダミードメイン
NEXT_PUBLIC_AUTH_DUMMY_DOMAIN=staff.koiwa-kenzai.local
